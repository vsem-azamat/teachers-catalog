# The project's internal router. It never terminates TLS and never talks to the
# internet: the shared Edge Caddy on the host owns 80/443 and proxies this
# project's hostname to the loopback port this listens on.

{
	# The edge already has the certificate. Asking for another one here would
	# fail, because nothing outside can reach this container.
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	# The API, which the app's own host proxies to: the Mini App lives at
	# APP_URL, in supervisor-telegram. See docs/architecture.md, «The app
	# lives elsewhere».
	@backend path /api/v1/* /healthz
	handle @backend {
		reverse_proxy api:8000
	}

	# Everything else is the app's, so an old link or a cached menu URL lands
	# on it, path and query intact.
	handle {
		redir {$APP_URL}{uri} permanent
	}
}
