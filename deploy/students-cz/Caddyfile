# The project's internal router. It never terminates TLS and never talks to the
# internet: the shared Edge Caddy on the host owns 80/443 and proxies this
# project's hostname to the loopback port this listens on.

{
	# The edge already has the certificate. Asking for another one here would
	# fail, because nothing outside can reach this container.
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	# The API is the same origin as the app, which is not
	# a convenience: since 20 July 2026 Telegram only allows Mini App API calls
	# from the app's own origin.
	# supervisor-telegram's public API: the chat directory, the advertising
	# reach and the join check. Same origin for the app, a different backend.
	# First, so the catch-all below never sees it. See docs/architecture.md,
	# «Two backends, one origin».
	@supervisor path /api/public/*
	handle @supervisor {
		reverse_proxy {$SUPERVISOR_ORIGIN} {
			header_up Host {upstream_hostport}
		}
	}

	@backend path /api/* /healthz
	handle @backend {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:8080
	}
}
