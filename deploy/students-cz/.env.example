# Written by CI on the runner and copied to the server as mode 0600. It is
# never committed and never edited by hand on the server — a deployment
# replaces it wholesale, and the previous copy is kept for rollback.
#
# Names only. Values come from GitHub Secrets and Variables.

GHCR_OWNER=
IMAGE_TAG=

POSTGRES_DB=students_cz
POSTGRES_USER=students_cz
POSTGRES_PASSWORD=

BOT_TOKEN=
WEBHOOK_SECRET=

# Public origin, including the scheme and nothing else: https://host
PUBLIC_HOST=
# Loopback port the shared Edge Caddy proxies to. Unique per project.
PUBLIC_PORT=

INIT_DATA_MAX_AGE_SECONDS=86400
LOG_LEVEL=INFO
# Who is told when a profile or a request appears. Empty means nobody, which
# is a working configuration — see docs/architecture.md.
OWNER_TG_ID=
BACKUP_HOUR_UTC=3
BACKUP_RETENTION_DAYS=14
