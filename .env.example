# Copy to .env and fill in. .env is gitignored and must stay that way —
# nothing in this file may ever hold a real token or password.

# ── Database ────────────────────────────────────────────────────────────
# Read by docker compose. Defaults are local-development only.
POSTGRES_USER=konnekt
POSTGRES_PASSWORD=konnekt
POSTGRES_DB=konnekt
POSTGRES_PORT=5433

# Read by the API. Must agree with the values above.
KONNEKT_DATABASE_URL=postgresql+asyncpg://konnekt:konnekt@127.0.0.1:5433/konnekt
KONNEKT_DB_ECHO=false

# ── Telegram ────────────────────────────────────────────────────────────
# From @BotFather. Never commit a real one.
KONNEKT_BOT_TOKEN=
# Any long random string. Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header; anything else is not Telegram.
#   openssl rand -hex 32
KONNEKT_WEBHOOK_SECRET=
# Public HTTPS origin the bot and the mini app are served from. Since
# 20 July 2026 Telegram only allows Mini App API calls from the app's own
# origin, so preview deployments on a different domain will not work.
KONNEKT_WEBHOOK_BASE_URL=

# ── Sessions ────────────────────────────────────────────────────────────
# Signs the short-lived token issued after validating Telegram initData.
#   openssl rand -hex 32
KONNEKT_JWT_SECRET=
